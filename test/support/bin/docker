#!/usr/bin/env node
// records every invocation and answers the queries local.sh makes
const fs = require('node:fs')

const argv = process.argv.slice(2)
const log = process.env.LMA_TEST_DOCKER_LOG
if (log) {
    const images = {}
    for (const k of ['LMA_POSTGRES_IMAGE', 'LMA_REDIS_IMAGE', 'LMA_PROXY_IMAGE']) {
        if (process.env[k]) images[k] = process.env[k]
    }
    fs.appendFileSync(log, JSON.stringify({ argv, images }) + '\n')
}

const env = (k, d) => (process.env[k] === undefined ? d : process.env[k])
const out = (s) => process.stdout.write(s + '\n')
const has = (re) => argv.some((a) => re.test(a))

switch (argv[0]) {
    case 'info':
        process.exit(env('LMA_TEST_DOCKER_DOWN', '0') === '1' ? 1 : 0)
        break
    case 'ps':
        break // no containers of ours are publishing ports
    case 'inspect':
        out(env('LMA_TEST_HEALTH', 'healthy'))
        break
    case 'compose':
        break // recorded above; that is the whole point
    case 'exec': {
        if (has(/^redis-cli$/)) { out('PONG'); break }
        if (has(/pg_dump|pg_restore/)) break
        if (!has(/^psql$/)) break
        if (has(/^ON_ERROR_STOP=0$/)) { // the restore itself
            const errors = Number(env('LMA_TEST_IMPORT_ERRORS', '0'))
            if (!errors) break
            for (let i = 0; i < errors; i++) {
                process.stderr.write(`ERROR:  relation "t${i}" does not exist\n`)
            }
            process.exit(1)
        }
        if (has(/pg_database/)) { out(env('LMA_TEST_DB_EXISTS', '1') === '1' ? '1' : ''); break }
        if (has(/information_schema\.tables/)) { out(env('LMA_TEST_DB_TABLES', '12')); break }
        if (has(/SELECT email FROM "user"/)) {
            for (const e of env('LMA_TEST_OTHER_ADMINS', '').split(',').filter(Boolean)) out(e)
            break
        }
        if (has(/lower\(email\) <>/)) break
        if (has(/lower\(email\) =/)) { out(env('LMA_TEST_ADMIN_MATCHES', '0')); break }
        if (has(/FROM "user"/)) { out(env('LMA_TEST_ADMIN_COUNT', '1')); break }
        if (has(/api_key/)) { out(env('LMA_TEST_PUBLISHABLE_KEY', 'pk_test')); break }
        break
    }
    default:
        break
}
process.exit(0)
